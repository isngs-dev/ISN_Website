# iSN Business Solutions — environment configuration
# Copy this file to .env (or .env.local) and fill in values as integrations go live.
# All variables are optional in development — the app falls back to mocked
# responses (see src/lib/api.js) when they are unset.

# --- API endpoints -----------------------------------------------------
# Base URLs for the lead capture / contact / chat / booking endpoints.
# Leave unset during development to use the built-in mock adapters.
VITE_LEADS_API_URL=
VITE_CONTACT_API_URL=
VITE_CHAT_API_URL=
VITE_BOOK_API_URL=

# --- CRM integration -----------------------------------------------------
# One of: hubspot | salesforce | gohighlevel | zoho | pipedrive | webhook
VITE_CRM_PROVIDER=

# --- Calendar / scheduling integration ------------------------------------
# One of: calendly | google | hubspot | gohighlevel | custom
VITE_CALENDAR_PROVIDER=
# If set, the booking modal renders this URL in an iframe instead of the
# built-in mock time-slot picker (e.g. a Calendly scheduling link).
VITE_CALENDAR_URL=

# --- Analytics -------------------------------------------------------------
# GTM container ID / GA4 measurement ID / Meta Pixel ID.
# Wire these into index.html and src/lib/analytics.js once accounts exist.
VITE_GTM_CONTAINER_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
